{
    "name": "efnext/security-addressing",
    "description": "Unguessable, readable public identifiers (prefix_body) and global object ids for Laravel models. Part of the ef.next Security Framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Efnext\\Security\\Addressing\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Efnext\\Security\\Addressing\\AddressingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
