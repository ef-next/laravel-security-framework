# --- ef.next Security Framework --------------------------------------------
# Every variable the three config files read, with its default. Copy the
# block into your application's .env and change what the comments tell you
# to. The "Production" block at the end is the minimum for a real deployment;
# `php artisan security:doctor --strict` tells you whether it is complete.

# --- Addressing ------------------------------------------------------------
# Identity of this service in global object ids (<service>:<type>:<public id>).
# Change it once, before the first id is handed out; never afterwards.
SECURITY_SERVICE_NAME=app

# Public id column, encoding and entropy (80 bits by default). Leave alone
# unless you have a documented reason.
SECURITY_PUBLIC_ID_COLUMN=public_id
SECURITY_PUBLIC_ID_ENCODING=base32
SECURITY_PUBLIC_ID_ENTROPY_BYTES=10
SECURITY_PUBLIC_ID_MAX_ATTEMPTS=5

# --- Tenancy ---------------------------------------------------------------
# Users table primary key type: unsignedBigInteger | uuid | ulid | string
TENANT_USER_KEY_TYPE=unsignedBigInteger

# Connection that holds tenants and memberships (empty = default connection)
TENANT_DB_CONNECTION=

# Tenant lookup cache: store (empty = default cache store), TTL in seconds,
# and how long an unknown identifier is remembered (blunts enumeration load).
TENANT_CACHE_ENABLED=true
TENANT_CACHE_STORE=
TENANT_CACHE_TTL=60
TENANT_CACHE_NEGATIVE_TTL=5

# Reject Sanctum tokens without a tenant:<id> ability on tenant routes
TENANT_TOKENS_REQUIRE_BINDING=false

# --- Audit -----------------------------------------------------------------
# Signing keys: generate with `php artisan audit:key:generate`, format
# "k1:base64:<key>[,k2:base64:<key>]". Keep them in a secret manager, never
# next to the database credentials: a database-level attacker who also has
# the key can rewrite history consistently.
AUDIT_SIGNING_KEYS=
AUDIT_SIGNING_ACTIVE_KEY=

# "required": every event needs a tenant; "nullable": tenant-less events form
# the global chain. Security events of the tenant package always go to the
# global chain when no tenant is active, whatever this says.
AUDIT_TENANT_POLICY=required

# Optional dedicated connection for the audit tables. Minimal grants:
# SELECT, INSERT on audit_events, audit_anchors, audit_verification_runs;
# SELECT, INSERT, UPDATE on audit_chain_heads.
AUDIT_DB_CONNECTION=

# Append-only triggers are installed by the migration; only disable this for
# read replicas or documented exceptions. It is logged loudly.
AUDIT_ENFORCE_APPEND_ONLY=true

# Pepper for pseudonymised identifiers in metadata (empty = derived from
# APP_KEY). Rotating it is the closest thing to crypto-shredding the log offers.
AUDIT_PSEUDONYM_KEY=

# Anchor stores, comma-separated, external store first: database, filesystem,
# log, or the class name of your own AnchorStore. Pointing the disk at a bucket
# does nothing on its own — "filesystem" has to be in this list.
AUDIT_ANCHOR_STORES=database
AUDIT_ANCHOR_DISK=local
AUDIT_ANCHOR_PATH=audit-anchors
# Log channel for the write-only "log" store (forward it to a SIEM)
AUDIT_ANCHOR_LOG_CHANNEL=

# --- Production ------------------------------------------------------------
# In APP_ENV=production the audit provider refuses to boot without a signing
# key, on SQLite, with append-only enforcement disabled or without a readable
# anchor store. AUDIT_FAIL_FAST=false is the deliberate, temporary exception.
AUDIT_FAIL_FAST=true

# High-security profile: production also refuses to boot unless an anchor
# store outside the audit database is configured and answers, and
# `security:doctor --strict` fails while this is off. Switch it on as soon as
# the bucket exists — the bucket needs Object Lock (compliance mode) and a
# retention at least as long as your audit retention; the framework cannot
# make storage immutable, only use it.
AUDIT_REQUIRE_EXTERNAL_ANCHOR=false

# A complete production setting looks like this (filesystem disk "audit-anchors"
# defined in config/filesystems.php with its own credentials, not the
# application's):
#
#   AUDIT_SIGNING_KEYS=k1:base64:<value from the secret manager>
#   AUDIT_SIGNING_ACTIVE_KEY=k1
#   AUDIT_ANCHOR_STORES=filesystem,database
#   AUDIT_ANCHOR_DISK=audit-anchors
#   AUDIT_REQUIRE_EXTERNAL_ANCHOR=true
#   AUDIT_FAIL_FAST=true
#
# then: php artisan security:doctor --strict   (exit 0 = the deployment gate is open)
