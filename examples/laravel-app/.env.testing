# Loaded instead of .env when APP_ENV=testing (phpunit.xml sets that). Test-only
# values; nothing here is a secret. The audit keyring is set so that the tests
# exercise the signed path — without it events are hashed and chained but not
# signed, exactly what security:doctor would report as a FAIL.
APP_NAME="Billing example"
APP_ENV=testing
APP_KEY=base64:C+PcufIMWkeKpjYWZ1V5mPn3qKRSqmjsjFDxl+ICty4=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# ef.next Security Framework
SECURITY_SERVICE_NAME=billing
AUDIT_SIGNING_KEYS="k1:base64:G1PNa3s6jU9YctCAzj8qV1k/IZ6A2dJl4zeAPMwQXbM="
AUDIT_SIGNING_ACTIVE_KEY=k1
