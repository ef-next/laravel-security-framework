{
    "name": "efnext/security-tenant",
    "description": "Fail-closed tenant isolation for Laravel: tenant context, global scopes that refuse to run without a tenant, membership middleware and queue propagation. Part of the ef.next Security Framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "efnext/security-addressing": "self.version",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/session": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/http-kernel": "^7.0"
    },
    "suggest": {
        "laravel/sanctum": "For tenant-bound API tokens (EnsureTokenTenant middleware)."
    },
    "autoload": {
        "psr-4": {
            "Efnext\\Security\\Tenant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Efnext\\Security\\Tenant\\TenantServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
